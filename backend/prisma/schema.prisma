// ===========================================================================
// Prisma Schema - Helpdesk + GLPI Integration
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Users / Technicians
// ===========================================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(AGENT) // Campo original mantido
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Status em tempo real
  status           AgentStatus @default(OFFLINE)
  lastStatusChange DateTime?
  lastSeenAt       DateTime?

  // Integração GLPI
  glpiUserId  Int? // ID do usuário no GLPI
  glpiGroupId Int? // ID do grupo no GLPI (N1, N2, N3)

  // Nível técnico
  technicianLevel TechnicianLevel @default(N1)

  // Alertas
  phoneNumber   String? // WhatsApp para receber alertas
  receiveAlerts Boolean @default(true)
  sector        Sector  @default(TI)

  // Notification Preferences (Phase 5)
  notificationSound String  @default("default") // default, bell, chime, ping, custom
  customSoundUrl    String? // URL to custom sound file
  soundEnabled      Boolean @default(true)
  soundVolume       Int     @default(80) // 0-100

  // Onboarding (ativação por link)
  activatedAt      DateTime? // null = ativação pendente
  activationTokens UserActivationToken[]

  deletedAt DateTime?

  tickets           Ticket[]
  messages          Message[]
  alerts            TechnicianAlert[]
  teamMessages      TeamMessage[]
  csatResponses     CsatResponse[]
  cannedResponses   CannedResponse[]
  knowledgeArticles KnowledgeArticle[]

  agentMetrics    AgentMetric[]
  articleFeedback ArticleFeedback[]
  messageReads    MessageRead[]

  assetsOwned       Asset[]            @relation("AssetCurrentOwner")
  assetAssignments  AssetAssignment[]
  pushSubscriptions PushSubscription[]

  technicalReportsAsEngineer   TechnicalReport[]           @relation("ReportEngineer")
  technicalReportsAsTechnician TechnicalReport[]           @relation("ReportTechnician")
  technicalReportsCreated      TechnicalReport[]           @relation("ReportCreator")
  technicalReportAnnotations   TechnicalReportAnnotation[]
  technicalReportSignatures    TechnicalReportSignature[]

  @@index([role, active])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ✅ NOVO: Roles customizáveis

enum Role {
  ADMIN
  AGENT
  ADMIN_TI
  ADMIN_ELECTRIC
  ADMIN_COMPRAS
}

enum TechnicianLevel {
  N1 // Primeiro nível - atendimento básico
  N2 // Segundo nível - suporte intermediário
  N3 // Terceiro nível - especialista
}

enum Sector {
  TI
  ELECTRIC
  COMPRAS
}

enum AgentStatus {
  ONLINE // Disponível para atendimento
  BUSY // Ocupado (não aceita novos tickets)
  IN_SERVICE // Em atendimento
  IDLE // Ocioso/Ausente
  OFFLINE // Desconectado
}

// ===========================================================================
// Tickets
// ===========================================================================

model Ticket {
  id           String       @id @default(uuid())
  glpiId       Int?         @unique // ID do ticket no GLPI
  title        String
  description  String
  status       TicketStatus @default(NEW)
  priority     Priority     @default(NORMAL)
  phoneNumber  String? // Telefone do cliente (opcional — tickets criados via web podem não ter)
  customerName String? // Nome do cliente (coletado pelo bot)
  sector       Sector?
  category     String? // Categoria/tipo do problema

  // Campos de fechamento
  solution     String? // Texto da solução aplicada
  solutionType String? // Categoria da solução (Hardware, Software, etc)
  timeWorked   Int? // Tempo trabalhado em minutos

  // Avaliação
  rating         Int? // Nota 1-5 dada pelo cliente
  ratedAt        DateTime? // Quando avaliou
  awaitingRating Boolean   @default(false) // Se está aguardando avaliação

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  type     TicketType @default(SUPPORT)
  location String? // Local do serviço (ex: Filial X, Torre Y)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?
  escalatedAt DateTime? // Timestamp do último escalonamento
  deletedAt   DateTime?

  messages     Message[]
  partUsages   PartUsage[]
  attachments  Attachment[]
  csatResponse CsatResponse?
  labels       TicketLabel[]
  emailMapping EmailTicketMapping?

  affectedAssetId String?
  affectedAsset   Asset?  @relation("AssetTickets", fields: [affectedAssetId], references: [id])

  slaTimer SlaTimer?

  technicalReports TechnicalReport[]

  @@index([phoneNumber])
  @@index([status])
  @@index([glpiId])
  @@index([status, assignedToId])
  @@index([createdAt(sort: Desc)])
  @@index([type]) // Index para relatórios
  @@index([status, createdAt(sort: Desc)])
  @@map("tickets")
}

enum TicketType {
  SUPPORT // Chamado padrão (Reativo)
  SERVICE_REPORT // Relatório de Serviço (Proativo/Externo)
}

enum TicketStatus {
  NEW // Novo - aguardando atendimento
  ASSIGNED // Atribuído a um técnico
  IN_PROGRESS // Em atendimento
  WAITING_CLIENT // Aguardando resposta do cliente
  RESOLVED // Resolvido
  CLOSED // Fechado
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ===========================================================================
// Messages
// ===========================================================================

model Message {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  content   String
  type      MessageType @default(TEXT)
  direction Direction

  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id])

  waMessageId String?

  isInternal Boolean  @default(false)
  mentions   String[] @default([])

  mediaUrl     String?
  fileName     String?
  fileSize     Int?
  duration     Int?
  thumbnailUrl String?

  reads     MessageRead[]
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  @@index([ticketId])
  @@index([ticketId, createdAt(sort: Desc)])
  @@index([isInternal])
  @@map("messages")
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_reads")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum Direction {
  INCOMING // Cliente → Sistema
  OUTGOING // Sistema → Cliente
}

// ===========================================================================
// Bot Session State (backup do Redis)
// ===========================================================================

model BotSession {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  state       String // Estado atual da conversa (JSON)
  data        String? // Dados coletados (JSON)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
  @@map("bot_sessions")
}

// ===========================================================================
// Queues / Skills
// ===========================================================================

model Queue {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  skills      String // JSON array de skills
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active])
  @@map("queues")
}

// ===========================================================================
// Parts Inventory - Controle de Peças
// ===========================================================================

model Part {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // SKU/Código interno
  description String?
  quantity    Int      @default(0)
  minQuantity Int      @default(5) // Alerta de estoque baixo
  unitCost    Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usages PartUsage[]

  @@index([active])
  @@index([name])
  @@map("parts")
}

// ===========================================================================
// Part Usage - Peças usadas nos tickets
// ===========================================================================

model PartUsage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  partId    String?
  part      Part?    @relation(fields: [partId], references: [id])
  partName  String // Nome da peça (útil para peças compradas avulso)
  quantity  Int
  unitCost  Decimal  @db.Decimal(10, 2)
  purchased Boolean  @default(false) // Se foi comprada para este chamado
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("part_usages")
}

// ===========================================================================
// FAQ - Base de Conhecimento
// ===========================================================================

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  keywords  String // Palavras-chave separadas por vírgula
  category  String?
  views     Int      @default(0)
  helpful   Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([keywords])
  @@map("faqs")
}

// ===========================================================================
// Technician Alerts - Alertas para técnicos
// ===========================================================================

model TechnicianAlert {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String? // ID local do ticket
  glpiId   Int? // ID do ticket no GLPI

  type    AlertType
  message String

  sentViaWa   Boolean   @default(false) // Enviado via WhatsApp
  sentViaPush Boolean   @default(false) // Enviado via Socket.IO
  readAt      DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([ticketId])
  @@map("technician_alerts")
}

enum AlertType {
  NEW_TICKET // Novo ticket atribuído
  ESCALATED // Ticket escalonado do nível anterior
  SLA_WARNING // 75% do tempo SLA atingido
  SLA_BREACH // SLA estourado
  NEW_MESSAGE // Nova mensagem do cliente
  TRANSFERRED // Ticket transferido para você
}

// ===========================================================================
// Attachments - Arquivos anexados aos tickets
// ===========================================================================

model Attachment {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  filename String // Nome original do arquivo
  path     String // Caminho no servidor
  mimeType String // image/jpeg, etc
  size     Int // Tamanho em bytes

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("attachments")
}

// ===========================================================================
// Contacts - Contatos cadastrados por setor (Enhanced - Chatwoot Style)
// ===========================================================================

model Contact {
  id String @id @default(uuid())

  jid         String  @unique // JID completo do WhatsApp (ex: "123456789:0@s.whatsapp.net")
  phoneNumber String? // Número para exibição (opcional temporariamente)
  name        String // Nome do contato
  email       String? // Email do contato
  sector      Sector
  company     String? // Empresa/Organização
  department  String? // Departamento/subdivisão
  ramal       String? // Ramal telefônico

  // WhatsApp Profile
  profilePicUrl       String? // URL da foto de perfil do WhatsApp
  profilePicUpdatedAt DateTime? // Última atualização da foto de perfil

  // Custom attributes (inspirado no Chatwoot)
  customAttributes Json? @default("{}") // { "cargo": "Gerente", "ramal": "2045" }

  // Estatísticas
  firstContactAt DateTime @default(now())
  lastContactAt  DateTime @default(now())
  totalTickets   Int      @default(0)

  // Spam & Blocking
  isBlocked   Boolean   @default(false)
  blockedAt   DateTime?
  blockedBy   String? // UserID que bloqueou
  blockReason String? // Motivo do bloqueio
  spamScore   Int       @default(0) // Score de spam (0-100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([jid])
  @@index([phoneNumber])
  @@index([sector])
  @@index([email])
  @@index([isBlocked])
  @@index([spamScore])
  @@index([deletedAt])
  @@map("contacts")
}

model Printer {
  id String @id @default(uuid())

  name         String // Nome amigável
  ip           String  @unique // IP da impressora
  port         Int     @default(161) // Porta SNMP
  community    String  @default("public") // Community SNMP
  model        String? // Modelo detectado via SNMP
  serialNumber String? // Número de série
  location     String? // Localização física

  // Cache do último status
  lastStatus       String? // online, offline, error
  lastTonerBlack   Int? // Nível toner preto (0-100)
  lastTonerCyan    Int? // Nível toner ciano
  lastTonerMagenta Int? // Nível toner magenta
  lastTonerYellow  Int? // Nível toner amarelo
  lastPageCount    Int? // Contador de páginas
  lastCheckedAt    DateTime? // Última verificação

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ip])
  @@map("printers")
}

// ===========================================================================
// Team Chat - Chat interno para técnicos
// ===========================================================================

model TeamMessage {
  id        String   @id @default(uuid())
  content   String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  sector    Sector   @default(TI)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sector])
  @@map("team_messages")
}

// ===========================================================================
// Suppliers - Fornecedores
// ===========================================================================

model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  cnpj      String?
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@index([active])
  @@map("suppliers")
}

// ===========================================================================
// Purchases - Registro de Compras de Equipamentos
// ===========================================================================

enum EquipmentCategory {
  COMPUTER
  PRINTER
  MONITOR
  PERIPHERAL
  NETWORK
  SOFTWARE
  OTHER
}

model Purchase {
  id String @id @default(uuid())

  // Equipamento
  name         String // Ex: "Impressora HP LaserJet Pro"
  category     EquipmentCategory @default(OTHER)
  serialNumber String?
  assetTag     String? // Patrimônio
  quantity     Int               @default(1)
  unitPrice    Decimal           @db.Decimal(10, 2)

  // Fornecedor
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  supplierName String? // Backup caso não use fornecedor cadastrado

  // Destino
  sector          Sector
  location        String? // Local específico
  responsibleName String? // Responsável pelo recebimento

  // Documento fiscal
  invoiceNumber  String? // Número da NF
  invoiceDate    DateTime? // Data da NF
  warrantyMonths Int? // Meses de garantia

  // GLPI
  glpiAssetId  Int? // ID do ativo no GLPI após sincronização
  syncedToGlpi Boolean @default(false)

  // Controle
  purchaseDate DateTime @default(now())
  notes        String?
  createdById  String? // Quem registrou
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sector])
  @@index([category])
  @@index([purchaseDate])
  @@map("purchases")
}

// ===========================================================================
// Purchase Requests - Requisições de Compra (Aprovação Compras)
// ===========================================================================

enum PurchaseRequestStatus {
  PENDING // Aguardando aprovação
  APPROVED // Aprovada
  REJECTED // Rejeitada
  CANCELLED // Cancelada pelo solicitante
  PURCHASED // Comprada (produto adquirido)
  DELIVERED // Entregue ao solicitante
}

model PurchaseRequest {
  id String @id @default(uuid())

  // Descrição
  title          String
  description    String   @db.Text
  quantity       Int      @default(1)
  estimatedValue Decimal? @db.Decimal(10, 2)

  // Justificativa
  justification String? @db.Text

  // Setor solicitante
  sector         Sector
  requesterName  String
  requesterPhone String?
  requestedById  String? // User ID do solicitante

  // Link com Ticket (se criada a partir de um chamado)
  ticketId String?

  // Status
  status PurchaseRequestStatus @default(PENDING)

  // Aprovação
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Compra
  purchasedById String?
  purchasedAt   DateTime?

  // Entrega
  deliveredById String?
  deliveredAt   DateTime?

  // Controle
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([requestedById])
  @@map("purchase_requests")
}

// ===========================================================================
// Report Recipients - Destinatários de Relatórios (!ceo)
// ===========================================================================

model ReportRecipient {
  id        String   @id @default(uuid())
  name      String
  jid       String   @unique // WhatsApp JID
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
  @@map("report_recipients")
}

// ===========================================================================
// Stock Items - Controle Unificado de Estoque (TI + Elétrica) [v2 ERP]
// ===========================================================================

model StockItem {
  id          String  @id @default(uuid())
  name        String
  code        String? @unique // SKU/Código interno
  description String?

  // Classificação
  stockType StockType    @default(TI) // TI ou ELECTRIC
  category  ItemCategory @default(SUPPLY) // SUPPLY, INK, ASSET

  // Quantidades e Unidades
  quantity    Decimal       @default(0) @db.Decimal(10, 2) // Suporta frações (1.5m, 0.5L)
  minQuantity Decimal       @default(5) @db.Decimal(10, 2)
  unit        UnitOfMeasure @default(UN)
  unitCost    Decimal?      @db.Decimal(10, 2)

  // Localização
  location String? // "Almoxarifado A", "Armário TI", ou Filial

  // Específico de Tintas
  printerModel String? // Para qual impressora serve
  inkColor     InkColor? // CYAN, MAGENTA, YELLOW, BLACK

  // Específico de Patrimônio
  assetTag     String? // Plaqueta de patrimônio (pode repetir por local)
  assetStatus  AssetStatus @default(AVAILABLE)
  isReservable Boolean     @default(false) // Pode ser reservado?

  // Controle
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  movements    StockMovement[]

  @@unique([assetTag, location]) // Patrimônio único por localização/filial
  @@index([stockType])
  @@index([category])
  @@index([assetStatus])
  @@index([stockType, active])
  @@index([category, assetStatus])
  @@map("stock_items")
}

enum StockType {
  TI
  ELECTRIC
}

enum ItemCategory {
  SUPPLY // Insumos (mouse, cabo, disjuntor)
  INK // Tintas e Toners
  ASSET // Patrimônio (projetor, notebook)
}

enum UnitOfMeasure {
  UN // Unidade
  M // Metro
  L // Litro
  ML // Mililitro
  CX // Caixa
  PCT // Pacote
  KG // Quilograma
}

enum InkColor {
  BLACK
  CYAN
  MAGENTA
  YELLOW
}

enum AssetStatus {
  AVAILABLE // Disponível para reserva
  RESERVED // Reservado
  IN_USE // Em uso
  MAINTENANCE // Em manutenção
}

// ===========================================================================
// Stock Movements - Log de Entrada/Saída de Estoque
// ===========================================================================

model StockMovement {
  id String @id @default(uuid())

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  type        MovementType // IN (entrada) ou OUT (saída)
  quantity    Decimal      @db.Decimal(10, 2)
  reason      String? // Motivo (ex: "Reposição", "Uso em ticket #123")
  performedBy String? // Nome/ID de quem realizou

  createdAt DateTime @default(now())

  @@index([stockItemId])
  @@index([createdAt])
  @@index([type])
  @@index([stockItemId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  IN // Entrada
  OUT // Saída
}

// ===========================================================================
// Tools / Equipment - Ferramentas e Equipamentos [v2 ERP]
// ===========================================================================

model Tool {
  id           String       @id @default(uuid())
  name         String
  category     ToolCategory @default(MANUAL)
  serialNumber String?
  brand        String?
  status       ToolStatus   @default(AVAILABLE)
  location     String?
  notes        String?

  stockType StockType @default(TI)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans ToolLoan[]

  @@index([status])
  @@index([stockType])
  @@map("tools")
}

enum ToolCategory {
  ELECTRICAL
  MANUAL
  MEASUREMENT
  NETWORK
  EQUIPMENT
  OTHER
}

enum ToolStatus {
  AVAILABLE
  LOANED
  MAINTENANCE
  BROKEN
}

model ToolLoan {
  id String @id @default(uuid())

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  borrower       String // Nome de quem pegou
  loanedBy       String? // Nome de quem emprestou
  reason         String?
  expectedReturn DateTime?

  returnedAt DateTime?
  returnedBy String?

  createdAt DateTime @default(now())

  @@index([toolId])
  @@index([returnedAt])
  @@map("tool_loans")
}

// ===========================================================================
// Reservations - Agendamento de Patrimônio [v2 ERP]
// ===========================================================================

model Reservation {
  id String @id @default(uuid())

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  // Solicitante
  userId     String? // Se for usuário do sistema
  userName   String // Nome do solicitante
  userPhone  String? // Telefone/WhatsApp
  userSector String? // Setor do solicitante

  // Período
  startTime DateTime
  endTime   DateTime

  // Status
  status ReservationStatus @default(PENDING)

  // Link com Ticket (se criado pelo bot)
  ticketId String?

  // Controle
  notes        String?
  approvedById String? // Quem aprovou
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([stockItemId])
  @@index([status])
  @@index([startTime])
  @@index([status, startTime])
  @@index([stockItemId, status])
  @@map("reservations")
}

enum ReservationStatus {
  PENDING // Aguardando aprovação
  APPROVED // Aprovada
  REJECTED // Rejeitada
  IN_USE // Em uso (retirado)
  COMPLETED // Devolvido
  CANCELLED // Cancelada
}

// ===========================================================================
// FASE 1 - FEATURE ABSORPTION
// ===========================================================================

// ===========================================================================
// CSAT - Pesquisa de Satisfação (Chatwoot)
// ===========================================================================

model CsatResponse {
  id       String @id @default(uuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  rating   Int // 1-5 (😡 a 😍)
  feedback String? // Texto opcional

  assignedToId String? // Técnico que atendeu
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  respondedAt DateTime @default(now())
  sentAt      DateTime // Quando foi enviada
  channel     String // 'whatsapp', 'web', 'email'

  // Review notes (do Chatwoot) — notas internas sobre o feedback
  reviewNote String?
  reviewedBy String?

  @@index([assignedToId])
  @@index([respondedAt])
  @@index([rating])
  @@index([ticketId])
  @@map("csat_responses")
}

// ===========================================================================
// Automation Rules - Engine de Automação (Chatwoot)
// ===========================================================================

model AutomationRule {
  id          String  @id @default(uuid())
  name        String
  description String?
  active      Boolean @default(true)

  // Evento gatilho
  event String // 'ticket_created', 'message_received', 'ticket_updated',
  // 'ticket_assigned', 'csat_received'

  // Condições (JSON) — Array de condições com operador AND/OR
  conditions        Json // [{ field: "priority", operator: "equals", value: "URGENT" }]
  conditionOperator String @default("AND") // AND | OR

  // Ações (JSON) — Array de ações a executar
  actions Json // [{ type: "assign_agent", value: "user-id" },
  //  { type: "add_label", value: "urgente" }]

  // Auditoria
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  executionCount Int       @default(0)
  lastExecutedAt DateTime?

  @@index([event, active])
  @@index([active])
  @@map("automation_rules")
}

// ===========================================================================
// Canned Responses - Respostas Prontas (Chatwoot)
// ===========================================================================

model CannedResponse {
  id        String  @id @default(uuid())
  shortcode String  @unique // Ex: "saudacao", "reiniciar_pc"
  content   String  @db.Text // Texto da resposta (suporta {{variáveis}})
  category  String? // "Geral", "TI", "Elétrica"

  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shortcode])
  @@index([category])
  @@map("canned_responses")
}

// ===========================================================================
// Webhooks de Saída (Chatwoot/Peppermint)
// ===========================================================================

model Webhook {
  id     String   @id @default(uuid())
  url    String
  events String[] // ['ticket_created', 'ticket_resolved', 'message_received']
  active Boolean  @default(true)
  secret String? // Para validar HMAC

  headers Json? // Headers customizados

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Logs
  logs WebhookLog[]

  @@index([active])
  @@map("webhooks")
}

model WebhookLog {
  id        String  @id @default(uuid())
  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  event      String
  payload    Json
  statusCode Int?
  response   String?
  error      String?

  createdAt DateTime @default(now())

  @@index([webhookId, createdAt])
  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_logs")
}

// ===========================================================================
// Knowledge Base - Wiki/Base de Conhecimento (Peppermint)
// ===========================================================================

model KnowledgeArticle {
  id       String @id @default(uuid())
  title    String
  content  String @db.Text // Markdown
  category String // "Procedimentos", "Troubleshooting", "Onboarding"

  isPublic   Boolean @default(false) // Se true, visível no Help Center
  isInternal Boolean @default(true) // Visível apenas para agentes

  tags String[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  views   Int @default(0)
  helpful Int @default(0) // Contagem de "útil"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback ArticleFeedback[]

  @@index([category])
  @@index([isPublic])
  @@index([tags])
  @@index([authorId])
  @@map("knowledge_articles")
}

// ===========================================================================
// Ticket Labels/Tags (Chatwoot)
// ===========================================================================

model TicketLabel {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  label String // "urgente", "vip", "hardware", etc
  color String? // Hex color para UI

  createdAt DateTime @default(now())

  @@unique([ticketId, label]) // Evita labels duplicadas no mesmo ticket
  @@index([ticketId])
  @@index([label])
  @@map("ticket_labels")
}

// ✅ PHASE 2 - Feature 3: Auto-Assignment Configuration
model AutoAssignmentConfig {
  id String @id @default(uuid())

  // Configuração
  enabled  Boolean @default(false)
  strategy String  @default("round_robin") // "round_robin", "least_busy", "random"

  // Filtros
  applyToSectors    String[] @default([]) // [] = todos os setores
  applyToPriorities String[] @default([]) // [] = todas as prioridades
  applyToCategories String[] @default([]) // [] = todas as categorias

  // Regras de atribuição
  respectSector Boolean @default(true) // Atribuir apenas ao técnico do mesmo setor
  respectLevel  Boolean @default(false) // Considerar nível técnico (N1, N2, N3)

  // Limites
  maxTicketsPerAgent Int? // Máximo de tickets ativos por agente (null = sem limite)

  // Horário de funcionamento
  workingHoursStart String? // "08:00"
  workingHoursEnd   String? // "18:00"
  workingDays       String[] @default(["mon", "tue", "wed", "thu", "fri"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("auto_assignment_config")
}

// ✅ PHASE 3 - Feature 1: Intent Detection & Classification
model IntentClassification {
  id String @id @default(uuid())

  // Mensagem original
  userMessage String
  phoneNumber String? // Usuário que enviou

  // Classificação
  intent     String // "abrir_ticket_ti", "reservar_equipamento", "consultar_faq", etc
  confidence Float // 0.0 - 1.0

  // Entidades extraídas (JSON)
  entities Json? // { "equipamento": "impressora", "problema": "não liga", "setor": "RH" }

  // Modelo usado
  provider String // "openai", "anthropic", "local"
  model    String? // "gpt-4", "claude-3-sonnet", etc

  // Ação tomada
  actionTaken String? // "created_ticket", "showed_faq", "manual_menu", etc
  ticketId    String? // Se criou ticket

  // Performance
  processingTime Int? // Milissegundos

  // Feedback e Aprendizado Contínuo
  feedbackCorrectIntent String? // Intent correto fornecido por agente (se IA errou)
  feedbackProvidedBy    String? // ID do agente que deu feedback
  feedbackProvidedAt    DateTime? // Quando o feedback foi dado
  wasCorrect            Boolean? // Se a classificação estava correta (null = não avaliado)

  // RAG - Contexto usado
  contextUsed     Json? // IDs de conversas/tickets similares usados como contexto
  similarityScore Float? // Score de similaridade com contexto (0-1)

  // Aprendizado
  usedForTraining Boolean @default(false) // Se foi usado para retreinar modelo
  trainingBatchId String? // ID do batch de treinamento

  createdAt DateTime @default(now())

  @@index([intent])
  @@index([phoneNumber])
  @@index([confidence])
  @@index([createdAt(sort: Desc)])
  @@index([wasCorrect])
  @@index([feedbackProvidedBy])
  @@map("intent_classifications")
}

// ✅ PHASE 3 - Feature 2: Agent Performance Metrics
model AgentMetric {
  id      String @id @default(uuid())
  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Período
  date DateTime @db.Date // Data do dia

  // Métricas do dia
  ticketsCreated    Int @default(0)
  ticketsResolved   Int @default(0)
  ticketsInProgress Int @default(0)

  // Tempos (em segundos)
  totalFirstResponseTime Int @default(0) // Soma de todos os tempos de 1ª resposta
  totalResolutionTime    Int @default(0) // Soma de todos os tempos de resolução
  firstResponseCount     Int @default(0) // Quantidade de primeiras respostas (para calcular média)
  resolutionCount        Int @default(0) // Quantidade de resoluções (para calcular média)

  // CSAT
  csatSum   Int @default(0) // Soma das notas
  csatCount Int @default(0) // Quantidade de avaliações

  // Calculados (campos virtuais computados no service)
  avgFirstResponseTime Float? // Calculado: totalFirstResponseTime / firstResponseCount
  avgResolutionTime    Float? // Calculado: totalResolutionTime / resolutionCount
  avgCsat              Float? // Calculado: csatSum / csatCount

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, date]) // Uma métrica por agente por dia
  @@index([agentId, date(sort: Desc)])
  @@index([date(sort: Desc)])
  @@map("agent_metrics")
}

// ✅ PHASE 3 - Feature 4: Dynamic Bot Variables
model BotVariable {
  id String @id @default(uuid())

  key         String  @unique // "company_name", "support_hours", "sla_normal", etc
  value       String // Valor da variável
  description String? // Descrição do que a variável faz
  category    String  @default("general") // "general", "sla", "messages", "contact"

  isSystem Boolean @default(false) // Variáveis do sistema não podem ser deletadas

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isSystem])
  @@map("bot_variables")
}

// ===========================================================================
// 🧠 ADAPTIVE AI SYSTEM - Learning & Evolution
// ===========================================================================

// Armazena conversas completas para RAG e análise
model ConversationHistory {
  id String @id @default(uuid())

  // Identificação
  ticketId    String? // Ticket relacionado (se houver)
  phoneNumber String // Telefone do usuário
  agentId     String? // Agente que atendeu

  // Conteúdo da conversa
  messages Json // Array de mensagens: [{ role: "user"|"agent"|"bot", content: "...", timestamp: "..." }]

  // Classificação e contexto
  primaryIntent  String? // Intent principal da conversa
  resolvedIntent String? // Intent final resolvido
  wasSuccessful  Boolean @default(false) // Se foi resolvido com sucesso
  resolutionType String? // "automated", "agent_transfer", "escalated"

  // Embeddings para busca semântica (armazenados como array de floats em JSON)
  embedding        Json? // Vector embedding da conversa inteira
  summaryEmbedding Json? // Vector embedding do resumo

  // Metadados
  summary   String? // Resumo gerado por IA da conversa
  keywords  String[] @default([]) // Palavras-chave extraídas
  sentiment String? // "positive", "neutral", "negative"
  topics    String[] @default([]) // Tópicos identificados

  // Qualidade
  userSatisfaction Int? // 1-5 se usuário avaliou
  agentRating      Int? // 1-5 se agente avaliou utilidade

  // Aprendizado
  usedAsContext       Int       @default(0) // Quantas vezes foi usado como contexto RAG
  similarityThreshold Float     @default(0.7) // Threshold mínimo para considerar similar
  lastUsedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([ticketId])
  @@index([agentId])
  @@index([primaryIntent])
  @@index([wasSuccessful])
  @@index([createdAt(sort: Desc)])
  @@index([usedAsContext(sort: Desc)])
  @@map("conversation_histories")
}

// Padrões detectados automaticamente pelo sistema
model ConversationPattern {
  id String @id @default(uuid())

  // Padrão identificado
  name        String @unique // "printer_jam_pattern", "network_timeout_pattern"
  description String // Descrição do padrão

  // Detecção
  triggerKeywords String[] // Palavras-chave que ativam o padrão
  intentSequence  String[] // Sequência de intents típica
  commonEntities  Json? // Entidades comuns: { "equipamento": ["impressora"], "erro": ["papel preso"] }

  // Solução sugerida
  suggestedIntent   String // Intent que deveria ser usado
  suggestedResponse String? // Resposta sugerida
  suggestedArticles String[] @default([]) // IDs de artigos FAQ relacionados

  // Estatísticas
  occurrences       Int   @default(1) // Quantas vezes foi detectado
  successRate       Float @default(0.0) // Taxa de resolução (0-1)
  avgResolutionTime Int? // Tempo médio de resolução (segundos)

  // Aprendizado
  confidence     Float     @default(0.5) // Confiança no padrão (0-1)
  lastDetectedAt DateTime?
  autoCreated    Boolean   @default(true) // Se foi criado automaticamente
  approvedBy     String? // ID do admin que aprovou (null = não aprovado)
  active         Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([confidence(sort: Desc)])
  @@index([occurrences(sort: Desc)])
  @@index([lastDetectedAt(sort: Desc)])
  @@map("conversation_patterns")
}

// Batch de treinamento para re-treinar modelos
model TrainingBatch {
  id String @id @default(uuid())

  // Informações do batch
  name        String
  description String?
  status      String  @default("pending") // "pending", "processing", "completed", "failed"

  // Dados de treinamento
  dataSource         String // "intent_classifications", "conversations", "manual_upload"
  startDate          DateTime? // Pegar dados a partir desta data
  endDate            DateTime? // Até esta data
  minConfidence      Float     @default(0.7) // Confidence mínimo para incluir
  includeCorrections Boolean   @default(true) // Incluir correções de agentes

  // Resultados
  samplesCount    Int? // Quantidade de amostras usadas
  trainingMetrics Json? // Métricas do treinamento: { "accuracy": 0.95, "loss": 0.05 }
  modelVersion    String? // Versão do modelo gerado
  improvements    Json? // Melhorias detectadas: { "intent_x": { "before": 0.85, "after": 0.92 } }

  // Deployment
  deployedAt      DateTime?
  deployedBy      String? // ID do admin que fez deploy
  previousBatchId String? // ID do batch anterior (para rollback)

  // Agendamento
  scheduledFor     DateTime? // Se foi agendado
  autoRetrain      Boolean   @default(false) // Re-treina automaticamente a cada N dias
  retrainFrequency Int? // Dias entre retreinamentos automáticos

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([autoRetrain])
  @@map("training_batches")
}

// Performance e analytics do sistema de IA
model AIPerformanceLog {
  id String @id @default(uuid())

  // Período
  date DateTime @db.Date
  hour Int? // Hora do dia (0-23) para analytics horárias

  // Métricas de classificação
  totalClassifications     Int    @default(0)
  correctClassifications   Int    @default(0)
  incorrectClassifications Int    @default(0)
  accuracy                 Float? // Calculado: correct / total

  // Distribuição por provider
  ollamaCount  Int @default(0)
  minimaxCount Int @default(0)
  glmCount     Int @default(0)

  // Performance
  avgProcessingTime Float? // Milissegundos
  avgConfidence     Float? // 0-1

  // Intents mais comuns
  topIntents Json? // { "abrir_ticket_ti": 45, "consultar_faq": 23, ... }

  // Feedback
  totalFeedbacks    Int @default(0)
  positiveFeedbacks Int @default(0)
  negativeFeedbacks Int @default(0)

  // RAG Usage
  ragQueriesCount    Int    @default(0)
  avgSimilarityScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, hour])
  @@index([date(sort: Desc)])
  @@map("ai_performance_logs")
}

// Knowledge Graph - Relações entre problemas e soluções
model KnowledgeNode {
  id String @id @default(uuid())

  // Tipo do nó
  nodeType String // "problem", "solution", "equipment", "error", "procedure"

  // Conteúdo
  title       String
  description String?
  content     Json? // Conteúdo estruturado

  // Embeddings
  embedding Json? // Vector para busca semântica

  // Relações (armazenadas como JSON para flexibilidade)
  relatedNodes Json? // { "causes": ["node_id1"], "solutions": ["node_id2"], "similar": ["node_id3"] }

  // Estatísticas de uso
  viewCount      Int       @default(0)
  usefulCount    Int       @default(0)
  notUsefulCount Int       @default(0)
  lastAccessedAt DateTime?

  // Qualidade
  confidence Float   @default(0.5) // Confiança na informação (0-1)
  source     String? // Origem: "agent_created", "auto_generated", "imported"
  verifiedBy String? // ID do admin que verificou
  verified   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeType])
  @@index([verified])
  @@index([confidence(sort: Desc)])
  @@index([usefulCount(sort: Desc)])
  @@map("knowledge_nodes")
}

// ===========================================================================
// PHASE 4 - CANAIS & KNOWLEDGE
// ===========================================================================

// ✅ PHASE 4 - Feature 1: Email-to-Ticket Configuration
model EmailConfig {
  id String @id @default(uuid())

  // IMAP Configuration
  imapHost     String
  imapPort     Int     @default(993)
  imapUser     String
  imapPassword String // Encrypted
  imapTls      Boolean @default(true)

  // SMTP Configuration (para respostas)
  smtpHost     String?
  smtpPort     Int?    @default(587)
  smtpUser     String?
  smtpPassword String? // Encrypted
  smtpTls      Boolean @default(true)

  // Settings
  enabled      Boolean @default(false)
  pollInterval Int     @default(60) // seconds
  autoAssign   Boolean @default(true)

  // Auto-categorization
  defaultPriority String  @default("NORMAL")
  defaultSector   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("email_configs")
}

model EmailTicketMapping {
  id       String @id @default(uuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  emailId   String  @unique // Message-ID do email
  threadId  String? // Para agrupar conversas
  fromEmail String
  toEmail   String
  subject   String

  createdAt DateTime @default(now())

  @@index([emailId])
  @@index([threadId])
  @@index([ticketId])
  @@map("email_ticket_mappings")
}

// ✅ PHASE 4 - Feature 2: Article Feedback
model ArticleFeedback {
  id        String           @id @default(uuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  helpful Boolean // true = helpful, false = not helpful
  comment String?

  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([userId])
  @@map("article_feedback")
}

// ===========================================================================
// PHASE 2 - CMDB Nativo: Asset, License e Assignment
// ===========================================================================

model Asset {
  id             String         @id @default(uuid())
  tag            String         @unique // patrimônio (QR code)
  serialNumber   String?        @unique
  name           String
  category       AssetCategory
  status         AssetLifecycle @default(IN_USE)
  sector         Sector
  location       String?
  manufacturer   String?
  model          String?
  purchaseDate   DateTime?
  warrantyEndsAt DateTime?
  notes          String?

  currentUserId String?
  currentUser   User?   @relation("AssetCurrentOwner", fields: [currentUserId], references: [id])

  assignments AssetAssignment[]
  tickets     Ticket[]            @relation("AssetTickets")
  licenses    LicenseAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector, status])
  @@index([category])
  @@index([currentUserId])
  @@map("assets")
}

enum AssetCategory {
  COMPUTER
  LAPTOP
  PRINTER
  PHONE
  PERIPHERAL
  NETWORK_DEVICE
  ELECTRICAL_TOOL
  OTHER
}

enum AssetLifecycle {
  IN_STOCK
  IN_USE
  IN_MAINTENANCE
  RETIRED
  LOST
}

model AssetAssignment {
  id         String    @id @default(uuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  reason     String?

  @@index([assetId, returnedAt])
  @@index([userId])
  @@map("asset_assignments")
}

model License {
  id         String      @id @default(uuid())
  software   String
  vendor     String?
  licenseKey String?
  type       LicenseType
  seats      Int         @default(1)
  expiresAt  DateTime?
  cost       Decimal?    @db.Decimal(10, 2)

  assignments LicenseAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("licenses")
}

enum LicenseType {
  PERPETUAL
  SUBSCRIPTION
  OEM
  VOLUME
}

model LicenseAssignment {
  id         String    @id @default(uuid())
  licenseId  String
  license    License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  assetId    String?
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  userId     String?
  assignedAt DateTime  @default(now())
  returnedAt DateTime?

  @@index([licenseId])
  @@index([assetId])
  @@index([userId])
  @@index([returnedAt])
  @@map("license_assignments")
}

// ===========================================================================
// PHASE 3 - SLA Engine
// ===========================================================================

model SlaPolicy {
  id                 String         @id @default(uuid())
  name               String
  sector             Sector
  priority           Priority
  responseTimeMins   Int // tempo para 1ª resposta
  resolutionTimeMins Int // tempo para fechar
  businessHoursId    String?
  businessHours      BusinessHours? @relation(fields: [businessHoursId], references: [id])
  active             Boolean        @default(true)

  @@unique([sector, priority])
  @@index([active])
  @@index([sector])
  @@map("sla_policies")
}

model BusinessHours {
  id       String @id @default(uuid())
  name     String
  timezone String @default("America/Sao_Paulo")
  schedule Json // { mon: [{start:"08:00", end:"18:00"}], ... }
  holidays Json? // ["2026-12-25", ...]

  policies SlaPolicy[]

  @@index([timezone])
  @@map("business_hours")
}

model SlaTimer {
  id                 String    @id
  ticketId           String    @unique
  ticket             Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policyId           String?
  startedAt          DateTime  @default(now())
  pausedAt           DateTime?
  resumedAt          DateTime?
  responseDueAt      DateTime
  resolutionDueAt    DateTime
  responseMetAt      DateTime?
  resolutionMetAt    DateTime?
  responseBreached   Boolean   @default(false)
  resolutionBreached Boolean   @default(false)

  @@index([responseDueAt, responseMetAt])
  @@index([resolutionDueAt, resolutionMetAt])
  @@map("sla_timers")
}

model EscalationRule {
  id               String            @id @default(uuid())
  name             String
  sector           Sector
  triggerAfterMins Int
  triggerOn        EscalationTrigger
  action           Json // { type:"NOTIFY_MANAGER" } | { type:"REASSIGN", level:"L2" }
  active           Boolean           @default(true)

  @@index([sector])
  @@index([active])
  @@index([triggerOn, active])
  @@map("escalation_rules")
}

enum EscalationTrigger {
  NO_RESPONSE
  NO_RESOLUTION
  SLA_BREACH_IMMINENT
  SLA_BREACHED
}

// ===========================================================================
// Settings - Sistema de Configurações Dinâmicas
// ===========================================================================

model Setting {
  key   String @id // Chave única da configuração
  value String @db.Text // Valor (pode ser JSON, string, number, etc)

  description String? // Descrição da configuração
  category    String  @default("general") // Categoria: general, bot, email, notifications, etc
  dataType    String  @default("string") // string, number, boolean, json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("settings")
}

// Exemplos de configurações:
// key: "bot.greeting.message", value: "Olá! Como posso ajudar?"
// key: "bot.business.hours", value: '{"start": "08:00", "end": "18:00"}'
// key: "notifications.sound.enabled", value: "true"
// key: "email.poll.interval", value: "60"
// key: "sla.warning.threshold", value: "75"

// Push Notification Subscriptions (PWA)
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ===========================================================================
// AuditLog — LGPD Art. 37 (registro de operações)
// ===========================================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String? // denormalized for readability when user is deleted
  action     String // GET, POST, PUT, PATCH, DELETE
  resource   String // e.g. "tickets", "messages", "users"
  resourceId String? // ID do recurso acessado (quando aplicável)
  method     String // nome do método do controller
  path       String // URL completa
  ipAddress  String?
  userAgent  String?
  statusCode Int? // resposta HTTP
  metadata   String?  @db.Text // JSON com detalhes adicionais
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// Technical Reports — Laudos de serviço (NR-10/NR-35), com mídia + assinatura
// ===========================================================================

enum TechnicalReportStatus {
  DRAFT
  SUBMITTED
  REWORK
  APPROVED
}

enum SignerRole {
  ENGINEER
  TECHNICIAN
  CLIENT
}

model TechnicalReport {
  id           String                @id @default(uuid())
  number       String                @unique // RT-YYYY-NNNN
  sector       Sector
  title        String
  site         String
  serviceDate  DateTime
  engineerId   String?
  technicianId String?
  assistants   String[] // nomes livres dos auxiliares
  summary      String                @db.Text
  execution    String                @db.Text
  materials    String                @db.Text
  observations String                @db.Text
  status       TechnicalReportStatus @default(DRAFT)
  ticketId     String?
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  engineer    User?                       @relation("ReportEngineer", fields: [engineerId], references: [id])
  technician  User?                       @relation("ReportTechnician", fields: [technicianId], references: [id])
  createdBy   User                        @relation("ReportCreator", fields: [createdById], references: [id])
  ticket      Ticket?                     @relation(fields: [ticketId], references: [id])
  media       TechnicalReportMedia[]
  annotations TechnicalReportAnnotation[]
  signatures  TechnicalReportSignature[]

  @@index([sector, status])
  @@index([serviceDate])
  @@index([createdById])
  @@index([deletedAt])
  @@map("technical_reports")
}

model TechnicalReportMedia {
  id         String   @id @default(uuid())
  reportId   String
  filename   String
  path       String // path local /uploads/reports/
  mimeType   String
  size       Int
  uploadedBy String
  createdAt  DateTime @default(now())

  report TechnicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("technical_report_media")
}

model TechnicalReportAnnotation {
  id         String     @id @default(uuid())
  reportId   String
  authorId   String
  authorRole SignerRole
  field      String // qual campo da ficha (summary, execution, materials, etc)
  comment    String     @db.Text
  resolved   Boolean    @default(false)
  resolvedAt DateTime?
  createdAt  DateTime   @default(now())

  report TechnicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User            @relation(fields: [authorId], references: [id])

  @@index([reportId, resolved])
  @@map("technical_report_annotations")
}

model TechnicalReportSignature {
  id         String     @id @default(uuid())
  reportId   String
  signerId   String? // null se for cliente externo
  signerName String
  role       SignerRole
  imagePath  String // PNG salvo em /uploads/reports/signatures/
  ip         String?
  signedAt   DateTime   @default(now())

  report TechnicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  signer User?           @relation(fields: [signerId], references: [id])

  @@index([reportId])
  @@map("technical_report_signatures")
}

// ===========================================================================
// Onboarding — ativação de agente por link
// ===========================================================================

model UserActivationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 do token cru; o cru NUNCA é persistido
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("user_activation_tokens")
}
