# Backend Dockerfile.dev - Modo Desenvolvimento com Hot Reload
FROM node:22-alpine

WORKDIR /app

# Instalar dependências do sistema (ffmpeg: transcode de áudio webm→ogg/opus p/ WhatsApp)
RUN apk add --no-cache python3 make g++ ffmpeg

# Copiar package.json
COPY package*.json ./
COPY prisma ./prisma/

# Instalar dependências (incluindo devDependencies)
RUN npm install

# Gerar Prisma Client
RUN npx prisma generate

# Criar diretório de uploads com permissão correta
RUN mkdir -p /app/uploads/messages && chown -R node:node /app/uploads

# Expor portas (app + debug)
EXPOSE 3000 9229

# Iniciar em modo watch com debug habilitado
CMD ["npm", "run", "start:debug"]
