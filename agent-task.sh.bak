#!/bin/bash
# agent-task.sh - Executor de tarefas multi-agente

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

# Cores para output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }

# Função: Nova Feature Completa
new_feature() {
    local FEATURE_DESC="$1"
    local SESSION="feature-$(date +%s)"
    
    log_info "Iniciando desenvolvimento de feature: $FEATURE_DESC"
    log_info "Session ID: $SESSION"
    
    # Fase 1: Planejamento
    log_info "📝 Fase 1/5: Planejamento (PM Agent - Claude)"
    oh-my-ag agent:spawn pm "\
Planejar funcionalidade: $FEATURE_DESC

Contexto do Projeto - Chatbot de Suporte TI:
- WhatsApp via Baileys library
- Backend: Node.js + TypeScript + Express
- Database: PostgreSQL com Prisma
- Frontend Admin: React + TypeScript
- Autenticação: JWT
- Deploy: Docker + PM2

Entregar:
1. Arquitetura técnica detalhada
2. Componentes necessários (backend, frontend, database)
3. Modelos de dados (schema Prisma)
4. Endpoints da API
5. Fluxos de trabalho
6. Riscos e dependências
7. Estimativa de complexidade (simples/média/complexa)
" $SESSION
    
    log_success "Planejamento concluído"
    log_warning "Revise o plano em: .serena/memories/result-pm.md"
    read -p "Continuar com implementação? [Y/n] " -n 1 -r
    echo
    [[ $REPLY =~ ^[Nn]$ ]] && exit 0
    
    # Fase 2: Desenvolvimento Paralelo
    log_info "⚡ Fase 2/5: Desenvolvimento Paralelo"
    
    oh-my-ag agent:spawn backend "\
Implementar backend: $FEATURE_DESC

Referência de planejamento: .serena/memories/result-pm.md

Entregar:
- Schema/Models (Prisma)
- Controllers e Routes
- Services (lógica de negócio)
- Validações (Zod/Joi)
- Error handling
- Testes unitários básicos (Jest)
- Documentação inline

Padrões:
- Clean Architecture
- SOLID principles
- Error-first callbacks
- Async/await
" $SESSION -w ./src &
    
    oh-my-ag agent:spawn frontend "\
Implementar interface: $FEATURE_DESC

Referência de planejamento: .serena/memories/result-pm.md

Entregar:
- Componentes React (TypeScript)
- Hooks customizados se necessário
- Integração com API (axios/fetch)
- Formulários com validação (React Hook Form)
- Estados (loading, error, success)
- Responsividade (mobile-first)
- Estilização (Tailwind/styled-components)

Padrões:
- Componentes funcionais
- Props tipadas
- Error boundaries
- Acessibilidade básica (ARIA)
" $SESSION -w ./src/frontend &
    
    wait
    log_success "Desenvolvimento concluído"
    
    # Fase 3: QA
    log_info "🔍 Fase 3/5: Quality Assurance (QA Agent - Claude)"
    oh-my-ag agent:spawn qa "\
Revisar implementação: $FEATURE_DESC

Referências:
- Planejamento: .serena/memories/result-pm.md
- Backend: .serena/memories/result-backend.md
- Frontend: .serena/memories/result-frontend.md

Checklist de Revisão:

🔒 SEGURANÇA (Prioridade Alta)
- [ ] Validação de inputs (backend + frontend)
- [ ] SQL Injection protegido (Prisma ORM)
- [ ] XSS protegido (sanitização)
- [ ] CSRF tokens se necessário
- [ ] Autenticação/Autorização adequada
- [ ] Dados sensíveis não expostos
- [ ] Rate limiting considerado

⚡ PERFORMANCE
- [ ] Queries otimizadas (sem N+1)
- [ ] Índices de banco adequados
- [ ] Paginação implementada
- [ ] Payloads não excessivos
- [ ] Caching onde apropriado

🧪 CÓDIGO
- [ ] Tratamento de erros completo
- [ ] Logs adequados (sem info sensível)
- [ ] Sem código duplicado
- [ ] Testes com boa cobertura
- [ ] TypeScript sem 'any'
- [ ] Comentários onde necessário

🎨 UX/UI
- [ ] Feedback claro ao usuário
- [ ] Loading states
- [ ] Error messages úteis
- [ ] Responsivo mobile
- [ ] Acessibilidade básica

Entregar:
- Lista de issues encontrados (crítico/alto/médio/baixo)
- Sugestões de melhorias
- Aprovação ou bloqueio para produção
" $SESSION
    
    log_success "QA concluído"
    log_warning "Revise o relatório: .serena/memories/result-qa.md"
    read -p "Issues críticos encontrados? Precisa debug? [y/N] " -n 1 -r
    echo
    
    # Fase 4: Debug (condicional)
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        log_info "🐛 Fase 4/5: Debug (Debug Agent - Claude)"
        read -p "Descreva o(s) problema(s): " ISSUES
        
        oh-my-ag agent:spawn debug "\
Investigar e corrigir: $ISSUES

Feature: $FEATURE_DESC
Relatório QA: .serena/memories/result-qa.md

Processo:
1. Reproduzir o problema
2. Analisar logs/stack traces
3. Identificar causa raiz
4. Implementar correção
5. Adicionar teste de regressão
6. Validar correção

Entregar:
- Diagnóstico detalhado
- Correção implementada
- Teste de regressão
- Documentação da solução
" $SESSION
        
        log_success "Debug concluído"
        
        # Re-executar QA após correções
        log_info "Re-executando QA após correções..."
        oh-my-ag agent:spawn qa "Validar correções de: $ISSUES" $SESSION
    fi
    
    # Fase 5: Commit
    log_info "💾 Fase 5/5: Commit Convencional (Commit Agent - Gemini)"
    oh-my-ag agent:spawn commit "\
Criar commit para feature: $FEATURE_DESC

Analisar mudanças em:
- Backend (src/*)
- Frontend (src/frontend/*)
- Database (prisma/migrations/*)
- Testes (*.test.ts)

Gerar commit:
- Tipo: feat (ou fix se foi correção)
- Scope: apropriado ao módulo
- Description: clara e concisa
- Body: detalhes se necessário
- Breaking changes: se houver
- Co-authored-by: agentes envolvidos

Formato: Conventional Commits 1.0.0
" $SESSION
    
    log_success "Feature completa!"
    echo ""
    log_info "Session ID: $SESSION"
    log_info "Resultados em: .serena/memories/"
    log_info "Dashboard: bunx oh-my-ag dashboard"
}

# Função: Bug Fix Rápido
quick_bugfix() {
    local BUG_DESC="$1"
    local SESSION="bugfix-$(date +%s)"
    
    log_error "🐛 Bug Fix: $BUG_DESC"
    log_info "Session ID: $SESSION"
    
    # Debug direto
    log_info "Fase 1/3: Debug (Claude)"
    oh-my-ag agent:spawn debug "\
URGENTE - Corrigir bug: $BUG_DESC

Contexto do Sistema:
- Chatbot WhatsApp (Baileys)
- Node.js + TypeScript
- PostgreSQL + Prisma
- Redis (cache/fila)
- Docker

Processo Rápido:
1. Reproduzir problema
2. Analisar logs (PM2/Docker)
3. Causa raiz
4. Fix mínimo efetivo
5. Teste de regressão
6. Documentar solução

Entregar correção funcional ASAP
" $SESSION
    
    # QA focado
    log_info "Fase 2/3: Validação (Claude)"
    oh-my-ag agent:spawn qa "\
Validação rápida: $BUG_DESC

Focar apenas em:
1. Bug foi corrigido?
2. Não quebrou nada relacionado?
3. Teste de regressão adequado?
4. Pronto para produção?

Referência: .serena/memories/result-debug.md
" $SESSION
    
    # Commit
    log_info "Fase 3/3: Commit (Gemini)"
    oh-my-ag agent:spawn commit "\
Commit de bugfix: $BUG_DESC
Tipo: fix
Urgência: alta
" $SESSION
    
    log_success "Bug corrigido!"
    log_info "Session: $SESSION"
}

# Função: Análise/Planejamento
analyze() {
    local TOPIC="$1"
    local SESSION="analysis-$(date +%s)"
    
    log_info "📊 Análise: $TOPIC"
    
    oh-my-ag agent:spawn pm "\
Análise técnica completa: $TOPIC

Contexto: Chatbot de Suporte TI WhatsApp

Entregar documento detalhado:

## 1. VIABILIDADE
- Técnica (possível com stack atual?)
- Recursos (tempo, pessoas, infraestrutura)
- Custos estimados (desenvolvimento + operação)
- ROI esperado

## 2. ARQUITETURA
- Componentes envolvidos
- Integrações necessárias
- Mudanças no sistema atual
- Diagrama arquitetural (Mermaid)
- Stack tecnológica necessária

## 3. IMPLEMENTAÇÃO
- Fases de desenvolvimento
- MVPs intermediários
- Dependências técnicas
- Timeline estimado
- Critérios de sucesso

## 4. RISCOS & MITIGAÇÕES
- Técnicos
- Operacionais
- Negócio
- Planos de mitigação

## 5. ALTERNATIVAS
- Opção A vs B vs C
- Pros e contras de cada
- Recomendação fundamentada

## 6. DECISÃO
- Go / No-Go
- Justificativa
- Próximos passos

Stack Atual:
- Backend: Node.js, TypeScript, Express, Prisma
- Database: PostgreSQL
- Cache/Queue: Redis
- Frontend: React, TypeScript
- Deploy: Docker, PM2, nginx
- WhatsApp: Baileys library
" $SESSION
    
    log_success "Análise completa: .serena/memories/result-pm.md"
}

# Menu interativo
menu() {
    echo ""
    echo "╔══════════════════════════════════════════╗"
    echo "║   🤖 Multi-Agent Task Manager            ║"
    echo "║   Chatbot Suporte TI                     ║"
    echo "╚══════════════════════════════════════════╝"
    echo ""
    echo "1) 🚀 Nova Feature Completa"
    echo "2) 🐛 Bug Fix Rápido"
    echo "3) 📊 Análise/Planejamento"
    echo "4) 📈 Ver Dashboard"
    echo "5) �� Ver Estatísticas"
    echo "6) ❌ Sair"
    echo ""
    read -p "Escolha uma opção: " choice
    
    case $choice in
        1)
            read -p "Descreva a feature: " desc
            new_feature "$desc"
            ;;
        2)
            read -p "Descreva o bug: " desc
            quick_bugfix "$desc"
            ;;
        3)
            read -p "Tópico para análise: " desc
            analyze "$desc"
            ;;
        4)
            bunx oh-my-ag dashboard
            ;;
        5)
            bunx oh-my-ag stats
            ;;
        6)
            log_info "Até logo!"
            exit 0
            ;;
        *)
            log_error "Opção inválida"
            menu
            ;;
    esac
}

# Execução
if [ $# -eq 0 ]; then
    menu
else
    case "$1" in
        feature)
            new_feature "$2"
            ;;
        bugfix)
            quick_bugfix "$2"
            ;;
        analyze)
            analyze "$2"
            ;;
        *)
            echo "Uso: $0 [feature|bugfix|analyze] \"descrição\""
            echo "Ou execute sem argumentos para menu interativo"
            exit 1
            ;;
    esac
fi
