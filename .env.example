# =============================================================================
# Helpdesk MSM - Variáveis de Ambiente (Template)
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# Senhas devem ser geradas com: openssl rand -base64 32
# =============================================================================

# Database PostgreSQL
POSTGRES_PASSWORD=helpdesk123

# RabbitMQ
RABBITMQ_USER=helpdesk
RABBITMQ_PASSWORD=helpdesk123

# Redis (OBRIGATÓRIO em produção — habilita requirepass no docker-compose.yml)
# Gerar com: openssl rand -hex 32
REDIS_PASSWORD=altere-em-producao

# JWT (ALTERAR EM PRODUÇÃO! Gerar com: openssl rand -hex 64)
JWT_SECRET=sua-chave-secreta-jwt-altere-em-producao

# Cookie SSO (cross-subdomain auth)
COOKIE_DOMAIN=.helpdeskmsm.com.br
COOKIE_SECURE=true

# CORS — origens permitidas (separadas por vírgula)
# Em dev, incluir localhost:5173/5174/5175
FRONTEND_URL=https://ti.helpdeskmsm.com.br,https://eletrica.helpdeskmsm.com.br,https://compras.helpdeskmsm.com.br

# URL pública do frontend (base para links de ativação por email/WhatsApp)
# Sem barra final. Em dev, geralmente http://localhost:5173 ou http://localhost:8080.
APP_PUBLIC_URL=https://ti.helpdeskmsm.com.br

# Admin padrão (criado no primeiro run — ALTERAR EM PRODUÇÃO!)
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# =============================================================================
# AI / LLM Configuration
# =============================================================================

# MiniMax AI (Provider primário — chat + embeddings)
# Obter em: https://www.minimaxi.com/
MINIMAX_API_KEY=seu_minimax_api_key_aqui

# Ollama (LLM Local — Fallback quando MiniMax offline)
# Download: https://ollama.com/download
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Anthropic Claude (análise avançada + Co-Pilot, opcional)
# Obter em: https://console.anthropic.com/
ANTHROPIC_API_KEY=seu_anthropic_api_key_aqui
ANTHROPIC_MODEL=claude-sonnet-4-6

# =============================================================================
# WhatsApp Bot (Baileys nativo dentro do NestJS — substitui o Hermes)
# =============================================================================
# A conexão é pareada via QR em GET /api/whatsapp/qr. Sessão persistida em volume.
# A classificação de intenção usa MiniMax (acima) com fallback Ollama/GLM.

# Chave para endpoints internos server-to-server (header x-api-key).
# ALTERAR EM PRODUÇÃO! Gerar com: openssl rand -hex 32
INTERNAL_API_KEY=internal_dev_key_change_me

# =============================================================================
# PWA — Web Push (VAPID)
# =============================================================================
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@helpdeskmsm.com.br

# =============================================================================
# SMTP — envio transacional
# =============================================================================
SMTP_HOST=smtp.seuservidor.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=email@seudominio.com.br
SMTP_PASS=sua_senha_smtp
SMTP_FROM="Helpdesk MSM <email@seudominio.com.br>"
