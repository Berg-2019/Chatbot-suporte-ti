# =============================================================================
# Helpdesk WhatsApp + GLPI - Variáveis de Ambiente
# =============================================================================

# Database
POSTGRES_PASSWORD=helpdesk123

# RabbitMQ
RABBITMQ_USER=helpdesk
RABBITMQ_PASSWORD=helpdesk123

# JWT (ALTERAR EM PRODUÇÃO!)
JWT_SECRET=sua-chave-secreta-jwt-altere-em-producao

# GLPI API (obter no painel do GLPI após instalação)
# Configuração > Geral > API > Habilitar API REST
GLPI_APP_TOKEN=seu_app_token_aqui
GLPI_USER_TOKEN=seu_user_token_aqui

# Admin padrão (criado no primeiro run)
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# =============================================================================
# AI / LLM Configuration
# =============================================================================

# MiniMax AI (Provider primário para Intent Detection + Embeddings)
# Obter em: https://www.minimaxi.com/
# Modelo Chat: abab6-chat | Modelo Embedding: embo-01
MINIMAX_API_KEY=seu_minimax_api_key_aqui
MINIMAX_GROUP_ID=2029601411049730229  # Group ID fornecido

# Ollama (LLM Local - Fallback quando MiniMax offline)
# Download: https://ollama.com/download
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# GLM-4 (Zhipu AI - Backup secundário, opcional)
# Obter em: https://open.bigmodel.cn/
GLM_API_KEY=seu_glm_api_key_aqui

# OpenAI (Para embeddings e GPT-4o-mini, opcional)
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=seu_openai_api_key_aqui
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Anthropic Claude (Para análise avançada e Co-Pilot, opcional)
# Obter em: https://console.anthropic.com/
ANTHROPIC_API_KEY=seu_anthropic_api_key_aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# Hermes Agent Integration
# =============================================================================

# API Key para autenticar chamadas do Hermes aos endpoints /api/hermes/*
# ALTERAR EM PRODUÇÃO!
HERMES_API_KEY=hermes_dev_key_change_me

# URL do Hermes Tools Server (bridge entre Hermes e Backend)
# Usado quando o Hermes não acessa o backend diretamente
HERMES_TOOLS_URL=http://localhost:3003

# Habilitar modo Hermes no bot (true = Hermes como brain, false = flow-handler local)
HERMES_ENABLED=false

# OpenRouter API Key (usado pelo Hermes para acessar LLMs)
# Obter em: https://openrouter.ai/
OPENROUTER_API_KEY=seu_openrouter_api_key_aqui
